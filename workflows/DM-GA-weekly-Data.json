    {
      "parameters": {
        "jsCode": "// Normalize each campaign item the way your downstream expects\n// Input items are Google Ads response items\nconst out = [];\nfor (const item of $input.all()) {\n  const d = item.json;\n  // Some fields might be strings, numbers or undefined; normalize safely\n  let name = d.name || d.campaignName || \"N/A\";\n  let prop = name;\n  let category = \"\";\n  if (name.includes(\"-\")) {\n    const parts = name.split(\"-\");\n    prop = parts[0].trim();\n    category = parts.slice(1).join(\"-\").trim();\n  }\n\n  out.push({\n    json: {\n      \"Total Spent\": d.costMicros ? (parseFloat(d.costMicros) / 1e6 * 1).toFixed(2) * 1 : (d.cost ? Number(d.cost) : 0),\n      \"Clicks\": Number(d.interactions || d.clicks || 0),\n      \"Impressions\": Number(d.impressions || 0),\n      \"CTR\": d.ctr ? (parseFloat(d.ctr) * 100).toFixed(2) + \" %\" : (d.ctrString ? d.ctrString : \"0.00 %\"),\n      \"Conversions\": Number(d.conversions || 0),\n      \"Average Cost\": d.averageCost ? Number(d.averageCost).toFixed(2) : (d.avgCost ? Number(d.avgCost).toFixed(2) : 0),\n      \"Name\": name,\n      \"Prop\": prop,\n      \"Category\": category\n    }\n  });\n}\nreturn out;\n"
      },
      "id": "880834c3-6a3d-40fb-912a-77cdcea70b8d",
      "name": "Normalize Campaigns",

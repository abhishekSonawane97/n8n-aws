      "parameters": {
        "jsCode": "// CSS QC Validator for N8N - Minified CSS Support\n// Input: Array of objects with \"data\" field containing minified CSS\n// Output: Single array with all rules (passed + failed mixed in order)\n// Features: Full validation, occurrence tracking, exact CSS block extraction\n\nconst pageUrl = $('get-wid-min-css-url-d').first().json.pageUrl;\n\nclass CSSQCValidator {\n  constructor(cssContent, protectedVariables = []) {\n    this.cssContent = cssContent;\n    this.protectedVariables = protectedVariables;\n    this.ruleResults = [];\n  }\n\n  validate() {\n    this.checkDuplicateSelectors();\n    this.checkDuplicateProperties();\n    this.checkProtectedVariableOverrides();\n    this.checkEmptyVariables();\n    this.checkDeprecatedCSSUsage();\n    this.checkUnnecessaryImportant();\n    this.checkEmptyRulesets();\n    this.checkCommentedCode();\n\n    const passedRules = this.ruleResults.filter(r => r.status === 'Passed');\n    const failedRules = this.ruleResults.filter(r => r.status === 'Failed');\n\n    const totalIssues = failedRules.reduce((sum, rule) => {\n      return sum + rule.issues.length;\n    }, 0);\n\n    return {\n      isValid: failedRules.length === 0,\n      totalIssues: totalIssues,\n      totalRulesChecked: this.ruleResults.length,\n      passedRulesCount: passedRules.length,\n      failedRulesCount: failedRules.length,\n      rules: this.ruleResults\n    };\n  }\n\n  checkDuplicateSelectors() {\n    const selectors = this.extractSelectors();\n    const selectorMap = new Map();\n    const issues = [];\n\n    selectors.forEach(({ selector, cssBlock }) => {\n      const normalized = this.normalizeSelector(selector);\n      if (selectorMap.has(normalized)) {\n        const existingBlock = selectorMap.get(normalized);\n        issues.push({\n          selector: normalized,\n          message: `Duplicate selector \"${normalized}\" found`,\n          firstOccurrence: existingBlock,\n          secondOccurrence: cssBlock\n        });\n      } else {\n        selectorMap.set(normalized, cssBlock);\n      }\n    });\n\n    this.ruleResults.push({\n      ruleName: 'No Duplicate CSS Selectors',\n      status: issues.length === 0 ? 'Passed' : 'Failed',\n      issues: issues.length === 0\n        ? [{ message: 'No issues found under this rule', status: 'Passed' }]\n        : issues\n    });\n  }\n\n  checkDuplicateProperties() {\n    const ruleBlocks = this.extractRuleBlocks();\n    const issues = [];\n\n    ruleBlocks.forEach(({ selector, cssBlock, properties }) => {\n      const propertyMap = new Map();\n\n      properties.forEach(({ prop, value }) => {\n        const normalized = prop.trim().toLowerCase();\n        if (propertyMap.has(normalized)) {\n          issues.push({\n            selector: selector,\n            property: normalized,\n            message: `Duplicate property \"${normalized}\" in selector \"${selector}\"`,\n            cssBlock: cssBlock\n          });\n        } else {\n          propertyMap.set(normalized, value);\n        }\n      });\n    });\n\n    this.ruleResults.push({\n      ruleName: 'No Duplicate Properties Within Same Selector',\n      status: issues.length === 0 ? 'Passed' : 'Failed',\n      issues: issues.length === 0\n        ? [{ message: 'No issues found under this rule', status: 'Passed' }]\n        : issues\n    });\n  }\n\n  checkProtectedVariableOverrides() {\n    const definitionPattern = /--([\\w-]+)\\s*:\\s*([^;{}]+)/g;\n    const protectedSet = new Set(this.protectedVariables.map(v => v.replace('--', '')));\n    const issues = [];\n\n    let match;\n    while ((match = definitionPattern.exec(this.cssContent)) !== null) {\n      const varName = match[1];\n      if (protectedSet.has(varName)) {\n        const cssBlock = this.extractCSSBlockAroundPosition(match.index);\n        issues.push({\n          variable: `--${varName}`,\n          message: `Protected variable \"--${varName}\" is being redefined`,\n          cssBlock: cssBlock\n        });\n      }\n    }\n\n    this.ruleResults.push({\n      ruleName: 'Design Setting Variables Must Not Be Overridden',\n      status: issues.length === 0 ? 'Passed' : 'Failed',\n      issues: issues.length === 0\n        ? [{ message: 'No issues found under this rule', status: 'Passed' }]\n        : issues\n    });\n  }\n\n  checkEmptyVariables() {\n    const varPattern = /--([\\w-]+)\\s*:\\s*([^;{}]*?)[;{}]/g;\n    const issues = [];\n\n    let match;\n    while ((match = varPattern.exec(this.cssContent)) !== null) {\n      const varName = match[1];\n      const varValue = match[2].trim();\n\n      if (varValue === '' || varValue === '\"\"' || varValue === \"''\") {\n        const cssBlock = this.extractCSSBlockAroundPosition(match.index);\n        issues.push({\n          variable: `--${varName}`,\n          message: `Variable \"--${varName}\" has an empty value`,\n          cssBlock: cssBlock\n        });\n      }\n    }\n\n    this.ruleResults.push({\n      ruleName: 'No Variables With Empty Values',\n      status: issues.length === 0 ? 'Passed' : 'Failed',\n      issues: issues.length === 0\n        ? [{ message: 'No issues found under this rule', status: 'Passed' }]\n        : issues\n    });\n  }\n\n  checkDeprecatedCSSUsage() {\n    const deprecatedPatterns = [\n      { pattern: /:has\\s*\\(/gi, name: ':has() selector (limited browser support)' }\n    ];\n\n    const issues = [];\n\n    deprecatedPatterns.forEach(({ pattern, name }) => {\n      let match;\n      while ((match = pattern.exec(this.cssContent)) !== null) {\n        const cssBlock = this.extractCSSBlockAroundPosition(match.index);\n        issues.push({\n          deprecatedFeature: name,\n          message: `Deprecated CSS usage: \"${name}\"`,\n          cssBlock: cssBlock\n        });\n      }\n    });\n\n    this.ruleResults.push({\n      ruleName: 'No Deprecated CSS Usage',\n      status: issues.length === 0 ? 'Passed' : 'Failed',\n      issues: issues.length === 0\n        ? [{ message: 'No issues found under this rule', status: 'Passed' }]\n        : issues\n    });\n  }\n\n  checkUnnecessaryImportant() {\n    const ruleBlocks = this.extractRuleBlocks();\n    const issues = [];\n\n    ruleBlocks.forEach(({ selector, cssBlock, properties }) => {\n      properties.forEach(({ prop, value }) => {\n        if (value.includes('!important')) {\n          issues.push({\n            selector: selector,\n            property: prop.trim().toLowerCase(),\n            flaggedDeclaration: `${prop}:${value}`,\n            message: 'Unnecessary !important flag detected',\n            cssBlock: cssBlock\n          });\n        }\n      });\n    });\n\n    this.ruleResults.push({\n      ruleName: 'Flag Unnecessary Usage of !important',\n      status: issues.length === 0 ? 'Passed' : 'Failed',\n      issues: issues.length === 0\n        ? [{ message: 'No issues found under this rule', status: 'Passed' }]\n        : issues\n    });\n  }\n\n  checkEmptyRulesets() {\n    const emptyRulePattern = /([^{}]+)\\{\\s*\\}/g;\n    const issues = [];\n\n    let match;\n    while ((match = emptyRulePattern.exec(this.cssContent)) !== null) {\n      const selector = match[1].trim();\n      const cssBlock = match[0];\n      issues.push({\n        selector: selector,\n        message: `Empty ruleset found for selector \"${selector}\"`,\n        cssBlock: cssBlock\n      });\n    }\n\n    this.ruleResults.push({\n      ruleName: 'No Empty CSS Rulesets',\n      status: issues.length === 0 ? 'Passed' : 'Failed',\n      issues: issues.length === 0\n        ? [{ message: 'No issues found under this rule', status: 'Passed' }]\n        : issues\n    });\n  }\n\n  extractSelectors() {\n  const selectors = [];\n  \n  // First, remove all media query blocks entirely\n  const cssWithoutMedia = this.cssContent.replace(/@media[^{]*\\{[\\s\\S]*?\\}\\s*\\}/g, '');\n\n  const ruleBlockRegex = /([^{}]+)\\s*\\{([^}]*)\\}/g;\n  let match;\n\n  while ((match = ruleBlockRegex.exec(cssWithoutMedia)) !== null) {\n    const selector = match[1].trim();\n    const cssBlock = match[0];\n    if (selector && !selector.includes(':root') && !selector.includes('@media')) {\n      selectors.push({ selector, cssBlock });\n    }\n  }\n\n  return selectors;\n}\n\n  extractRuleBlocks() {\n    const blocks = [];\n    const ruleBlockRegex = /([^{}]+)\\s*\\{([^}]*)\\}/g;\n    let match;\n\n    while ((match = ruleBlockRegex.exec(this.cssContent)) !== null) {\n      const selector = match[1].trim();\n      const propertiesStr = match[2];\n      const cssBlock = match[0];\n      const properties = [];\n\n      const propPattern = /([^:;]+):([^;]+)/g;\n      let propMatch;\n      while ((propMatch = propPattern.exec(propertiesStr)) !== null) {\n        const prop = propMatch[1].trim();\n        const value = propMatch[2].trim();\n        if (prop && value) {\n          properties.push({ prop, value });\n        }\n      }\n\n      blocks.push({ selector, cssBlock, properties });\n    }\n\n    return blocks;\n  }\n\n  normalizeSelector(selector) {\n    return selector\n      .split(',')\n      .map(s => s.trim())\n      .filter(s => s)\n      .sort()\n      .join(', ');\n  }\n\n  checkCommentedCode() {\n  const issues = [];\n\n  // Match all /* ... */ comment blocks\n  const commentPattern = /\\/\\*[\\s\\S]*?\\*\\//g;\n  let match;\n\n  while ((match = commentPattern.exec(this.cssContent)) !== null) {\n    const commentContent = match[0];\n\n    // Check if comment contains actual CSS-like code\n    const hasCSSContent = (\n      /[a-zA-Z-]+\\s*:\\s*[^*]+/.test(commentContent) ||   // property: value\n      /[.#\\w]+\\s*\\{/.test(commentContent) ||              // selector {\n      /@media/.test(commentContent) ||                    // @media blocks\n      /--[\\w-]+\\s*:/.test(commentContent)                 // CSS variables\n    );\n\n    if (hasCSSContent) {\n      issues.push({\n        message: `Commented-out CSS code detected`,\n        cssBlock: commentContent.trim()\n      });\n    }\n  }\n\n  this.ruleResults.push({\n    ruleName: 'No Commented-Out CSS Code',\n    status: issues.length === 0 ? 'Passed' : 'Failed',\n    issues: issues.length === 0\n      ? [{ message: 'No issues found under this rule', status: 'Passed' }]\n      : issues\n  });\n}\n\n  extractCSSBlockAroundPosition(position) {\n    const contextLength = 150;\n    const start = Math.max(0, position - contextLength);\n    const end = Math.min(this.cssContent.length, position + contextLength);\n\n    let block = this.cssContent.substring(start, end);\n\n    const ruleStart = this.cssContent.lastIndexOf('{', position);\n    const ruleEnd = this.cssContent.indexOf('}', position);\n\n    if (ruleStart !== -1 && ruleEnd !== -1) {\n      block = this.cssContent.substring(ruleStart, ruleEnd + 1);\n    }\n\n    return block.trim();\n  }\n}\n\nconst protectedVariables = [\n  '--brand-color',\n  '--header-font-family',\n  '--text-font-family',\n  '--navbar-height'\n];\n\ntry {\n\n  const input = $input.first();\n\n  if (!input || !input.json) {\n    return [{\n      page_url: pageUrl,\n      isValid: false,\n      error: 'No input data received',\n      totalIssues: 0,\n      totalRulesChecked: 0,\n      passedRulesCount: 0,\n      failedRulesCount: 0,\n      rules: []\n    }];\n  }\n\n  const cssData = input.json.data;\n\n  if (!cssData) {\n    return [{\n      page_url: pageUrl,\n      isValid: false,\n      error: 'No CSS data found in \"data\" field',\n      totalIssues: 0,\n      totalRulesChecked: 0,\n      passedRulesCount: 0,\n      failedRulesCount: 0,\n      rules: []\n    }];\n  }\n\n  const validator = new CSSQCValidator(cssData, protectedVariables);\n  const validationResults = validator.validate();\n\n  return [{\n    page_url: pageUrl,\n    engg_name : $('get-wid-min-css-url-d').first().json.engg_name,\n    ...validationResults\n  }];\n\n} catch (error) {\n\n  return [{\n    page_url: pageUrl,\n    page_url: pageUrl,\n    isValid: false,\n    error: `Validation error: ${error.message}`,\n    totalIssues: 0,\n    totalRulesChecked: 0,\n    passedRulesCount: 0,\n    failedRulesCount: 0,\n    rules: []\n  }];\n\n}"

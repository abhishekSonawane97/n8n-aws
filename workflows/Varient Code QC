        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n\n  const rule = item.json;\n\n  if (!rule.issues || !Array.isArray(rule.issues)) continue;\n\n  const totalOccurrences = rule.issues.length;\n\n  for (const issue of rule.issues) {\n\n    // if (issue.status === \"Passed\") continue;\n\n    output.push({\n      json: {\n        ruleName: rule.ruleName || \"\",\n        status: rule.status || \"\",\n        selector: issue.selector || \"\",\n        message: issue.message || \"\",\n        cssBlock: issue.cssBlock || \"\",\n        firstOccurrence: issue.firstOccurrence || \"\",\n        secondOccurrence: issue.secondOccurrence || \"\",\n        totalOccurrences: totalOccurrences,\n        pageUrl : $('perform-qc-d').first().json.page_url,\n        engg_name : $('perform-qc-d').first().json.engg_name\n      }\n    });\n\n  }\n}\n\nreturn output;"

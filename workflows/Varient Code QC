        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const html = item.json.data;\n\n  // --- 1. Extract inline <style> tags (no src attribute) ---\n  const inlineStyleRegex = /<style(?![^>]*src)[^>]*>([\\s\\S]*?)<\\/style>/gi;\n  let inlineCSS = \"\";\n  let match;\n\n  while ((match = inlineStyleRegex.exec(html)) !== null) {\n    inlineCSS += match[1].trim() + \"\\n\";\n  }\n\n  // --- 2. Extract <link> tags where href contains \"simp-widgets.min\" ---\n  const linkTagRegex = /<link[^>]+href=[\"']([^\"']*simp-widgets\\.min[^\"']*)[\"'][^>]*>/gi;\n  const simpWidgetURLs = [];\n\n  while ((match = linkTagRegex.exec(html)) !== null) {\n    simpWidgetURLs.push(match[1]);\n  }\n\n  // --- 3. Extract all H1 tags ---\n  const h1Regex = /<h1[^>]*>([\\s\\S]*?)<\\/h1>/gi;\n  const h1Tags = [];\n\n  while ((match = h1Regex.exec(html)) !== null) {\n    const innerText = match[1]\n      .replace(/<[^>]+>/g, '')\n      .replace(/&nbsp;/g, ' ')\n      .replace(/&amp;/g, '&')\n      .replace(/&lt;/g, '<')\n      .replace(/&gt;/g, '>')\n      .replace(/\\s+/g, ' ')\n      .trim();\n    h1Tags.push(innerText);\n  }\n\n  // --- 4. Extract all <img> tags and check alt attribute ---\n  const imgRegex = /<img[\\s\\S]*?>/gi;\n  const imgMissingAlt = [];\n  const imgEmptyAlt   = [];\n  let imgTotal = 0;\n\n  while ((match = imgRegex.exec(html)) !== null) {\n    const tag = match[0];\n\n    // Skip tracking pixels / tiny images (width=1 or height=1)\n    if (/width=[\"']?1[\"']?/i.test(tag) || /height=[\"']?1[\"']?/i.test(tag)) continue;\n\n    imgTotal++;\n\n    // Extract src for reference in report\n    const srcMatch = tag.match(/src=[\"']([^\"']+)[\"']/i);\n    const src = srcMatch ? srcMatch[1] : 'unknown src';\n\n    const hasAlt = /\\balt\\s*=/i.test(tag);\n\n    if (!hasAlt) {\n      // alt attribute completely missing\n      imgMissingAlt.push({ src, tag });\n    } else {\n      // alt attribute present — check if empty or whitespace only\n      const altValueMatch = tag.match(/\\balt\\s*=\\s*[\"']([^\"']*)[\"']/i);\n      const altValue = altValueMatch ? altValueMatch[1].trim() : '';\n      if (altValue === '') {\n        imgEmptyAlt.push({ src, tag });\n      }\n    }\n  }\n\n  // --- 5. Extract all <video> tags and check title/aria-label attribute ---\n  const videoRegex = /<video[\\s\\S]*?>/gi;\n  const videoMissingTitle = [];\n  const videoEmptyTitle   = [];\n  let videoTotal = 0;\n\n  while ((match = videoRegex.exec(html)) !== null) {\n    const tag = match[0];\n    videoTotal++;\n\n    const hasTitle     = /\\btitle\\s*=/i.test(tag);\n    const hasAriaLabel = /\\baria-label\\s*=/i.test(tag);\n\n    if (!hasTitle && !hasAriaLabel) {\n      // Neither title nor aria-label present\n      videoMissingTitle.push({ tag });\n    } else {\n      // Check if title is present but empty\n      if (hasTitle) {\n        const titleValueMatch = tag.match(/\\btitle\\s*=\\s*[\"']([^\"']*)[\"']/i);\n        const titleValue = titleValueMatch ? titleValueMatch[1].trim() : '';\n        if (titleValue === '') {\n          videoEmptyTitle.push({ tag });\n        }\n      }\n      // Check if aria-label is present but empty\n      if (hasAriaLabel) {\n        const ariaValueMatch = tag.match(/\\baria-label\\s*=\\s*[\"']([^\"']*)[\"']/i);\n        const ariaValue = ariaValueMatch ? ariaValueMatch[1].trim() : '';\n        if (ariaValue === '') {\n          videoEmptyTitle.push({ tag });\n        }\n      }\n    }\n  }\n\n  results.push({\n    json: {\n      pageUrl: $('Loop Over Items').first().json.url,\n      engg_name: $('Loop Over Items').first().json.engg_name,\n      inlineCSS: inlineCSS || null,\n      simpWidgetCSSFiles: simpWidgetURLs,\n\n      // H1\n      h1Tags,\n      h1Count: h1Tags.length,\n\n      // Images\n      images: {\n        total:      imgTotal,\n        missingAlt: imgMissingAlt,\n        emptyAlt:   imgEmptyAlt,\n      },\n\n      // Videos\n      videos: {\n        total:        videoTotal,\n        missingTitle: videoMissingTitle,\n        emptyTitle:   videoEmptyTitle,\n      }\n    }\n  });\n}\n\nreturn results;"
      },

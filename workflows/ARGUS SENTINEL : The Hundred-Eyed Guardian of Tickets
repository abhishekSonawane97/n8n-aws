      "parameters": {
        "jsCode": "// --- TEAM NAME → TEAM ID MAP ---\nconst TEAM_MAP = {\n  \"Content Support\": \"293552000015408116\",\n  \"TechOps\": \"293552000015408132\",\n  \"Digital Marketing\": \"293552000052928033\",\n  \"Design\": \"293552000056750070\",\n  \"Customer Success\": \"293552000071837649\",\n  \"Content Specialist\": \"293552000153825051\",\n  \"Front-End Engineering\": \"293552000154462001\",\n  \"Simplotel Payments\": \"293552000251043635\",\n  \"Simplotel Finance\": \"293552000251043700\",\n  \"Simplotel Analytics\": \"293552000251043758\",\n  \"Simplotel Human Resources\": \"293552000251043818\",\n  \"Test\": \"293552000189972008\"\n};\n\nfunction sanitizeAndExtractTeam(rawText) {\n  if (!rawText || typeof rawText !== \"string\") return null;\n\n  // Remove markdown code blocks\n  let cleaned = rawText\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  // Try extracting JSON object portion\n  const jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    try {\n      const parsed = JSON.parse(jsonMatch[0]);\n      if (parsed.team) return parsed.team;\n    } catch (e) {\n      // continue to fallback\n    }\n  }\n\n  // Fallback regex extraction\n  const regexMatch = cleaned.match(/team[\"']?\\s*[:=]\\s*[\"']?([^,\"\\n}]+)/i);\n  if (regexMatch) {\n    return regexMatch[1].trim();\n  }\n\n  return null;\n}\n\n// ✅ NEW FUNCTION - Same logic as team extraction\nfunction sanitizeAndExtractTag(rawText) {\n  if (!rawText || typeof rawText !== \"string\") return null;\n\n  // Remove markdown code blocks\n  let cleaned = rawText\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  // Try extracting JSON object portion\n  const jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    try {\n      const parsed = JSON.parse(jsonMatch[0]);\n      if (parsed.tag) return parsed.tag;\n    } catch (e) {\n      // continue to fallback\n    }\n  }\n\n  // Fallback regex extraction\n  const regexMatch = cleaned.match(/tag[\"']?\\s*[:=]\\s*[\"']?([^,\"\\n}]+)/i);\n  if (regexMatch) {\n    return regexMatch[1].trim();\n  }\n\n  return null;\n}\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const raw = item.json.text;\n\n  const extractedTeam = sanitizeAndExtractTeam(raw);\n  const extractedTag = sanitizeAndExtractTag(raw); // ✅ Extract tag using same logic\n\n  const normalizedTeam = extractedTeam && TEAM_MAP[extractedTeam]\n    ? extractedTeam\n    : $input.first().json.team;\n\n  const teamId = normalizedTeam ? TEAM_MAP[normalizedTeam] : null;\n\n  output.push({\n    json: {\n      team: normalizedTeam,\n      teamId: teamId,\n      tag: extractedTag || \"\" // ✅ Use extracted tag\n    }\n  });\n}\n\nreturn output;"
      },
